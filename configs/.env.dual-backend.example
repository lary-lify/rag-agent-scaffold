# =====================================================================
# RAG + Agent 脚手架 —— 双后端开箱示例 .env
# 复制本文件为项目根目录下的 .env，按需保留「后端 A」或「后端 B」其中一段，
# 删掉另一段即可。CLI / FastAPI 入口不随后端变化，无需改动。
# =====================================================================

# ---------- 通用：LLM / Embeddings（OpenAI 兼容，可指向 DeepSeek 等） ----------
OPENAI_API_KEY=sk-your-key-here
# 接国产模型（如 DeepSeek）时把下面一行取消注释：
# OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ---------- 通用：文档切分 / 检索参数 ----------
DATA_DIR=./data
INDEX_PATH=./index
RETRIEVER_TOP_K=4


# =====================================================================
# 后端 A：FAISS（默认，本地零依赖，开箱即跑）
# 只需保留下面三行；Milvus / SQL 相关配置在本模式下不参与检索。
# =====================================================================
VECTOR_BACKEND=faiss
SQL_DOCSTORE_ENABLED=false
SQL_DOCSTORE_DSN=
SQL_DOCSTORE_TABLE=rag_chunks


# =====================================================================
# 后端 B：SQL + Milvus（生产化，向量在 Milvus，文本/元数据在 SQL）
# 启用本模式必须满足：VECTOR_BACKEND=milvus 且 SQL_DOCSTORE_ENABLED=true
# （二者必须同时，否则 build_index() / get_retriever() 会直接报错）。
# =====================================================================
# VECTOR_BACKEND=milvus
# MILVUS_URI=./milvus.db            # Milvus Lite 本地文件；接独立服务用 http://host:19530
# MILVUS_COLLECTION=rag_chunks
# SQL_DOCSTORE_ENABLED=true
# SQL_DOCSTORE_DSN=mysql+pymysql://user:pass@host:3306/rag   # 留空则用本地 sqlite
# SQL_DOCSTORE_TABLE=rag_chunks
