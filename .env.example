# ---- LLM / Embeddings (OpenAI 兼容接口，可指向 DeepSeek 等) ----
OPENAI_API_KEY=sk-your-key-here
# 留空则用默认 OpenAI；接国产模型例如：
# OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ---- RAG ----
DATA_DIR=./data
INDEX_PATH=./index
RETRIEVER_TOP_K=4

# ---- 向量库后端：faiss（默认，本地零依赖）或 milvus（生产化）----
# 切到 milvus 时必须同时启用 SQL 文档库（向量在 Milvus，文本/元数据在 SQL）
VECTOR_BACKEND=faiss
MILVUS_URI=./milvus.db            # Milvus Lite 本地文件；接服务用 http://host:19530
MILVUS_COLLECTION=rag_chunks

# ---- SQL 文档库（与 Milvus 配合；FAISS 下也可作为可选辅助存储）----
SQL_DOCSTORE_ENABLED=false
# 留空则用本地 sqlite（./rag_docs.db）；接 MySQL 例如：
# SQL_DOCSTORE_DSN=mysql+pymysql://user:pass@host:3306/rag
SQL_DOCSTORE_DSN=
SQL_DOCSTORE_TABLE=rag_chunks
